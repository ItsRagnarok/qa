{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mail.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
