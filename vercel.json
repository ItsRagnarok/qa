{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mail.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/plan-get", "destination": "/api/plan?op=get" },
    { "source": "/api/plan-toggle", "destination": "/api/plan?op=toggle" },
    { "source": "/api/plan-approve", "destination": "/api/plan?op=approve" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
